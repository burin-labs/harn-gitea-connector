import { activate, init, normalize_inbound, shutdown } from "../src/lib"

let BODY = "{\"action\":\"opened\",\"repository\":{\"full_name\":\"acme/widgets\"},\"sender\":{\"login\":\"ada\"},\"pull_request\":{\"number\":1}}"

let HEADERS = {"x-gitea-event": "pull_request", "x-gitea-delivery": "delivery-1"}

@complexity(allow)
pipeline default() {
  shutdown()
  // F3: with no signing secret configured, inbound webhooks fail-closed (401).
  init()
  activate([{id: "primary", path: "/hooks/gitea"}])
  let no_secret = normalize_inbound({binding_id: "primary", body_text: BODY, headers: HEADERS})
  assert_eq(no_secret.type, "reject", "fail-closed when no secret configured")
  assert_eq(no_secret.reject.status, 401, "fail-closed status is 401")
  shutdown()
  // Configure a signing secret via ctx/binding and exercise the verified paths.
  init({signing_secret: "super-secret"})
  activate([{id: "primary", path: "/hooks/gitea", secrets: {signing_secret: "super-secret"}}])
  let raw_signature = hmac_sha256("super-secret", BODY)
  let prefixed = normalize_inbound(
    {
      binding_id: "primary",
      body_text: BODY,
      headers: HEADERS + {"x-gitea-signature": "sha256=" + raw_signature},
    },
  )
  assert_eq(prefixed.event.signature_status.state, "verified", "sha256= prefixed signature verifies")
  let unprefixed = normalize_inbound(
    {binding_id: "primary", body_text: BODY, headers: HEADERS + {"x-gitea-signature": raw_signature}},
  )
  assert_eq(unprefixed.event.signature_status.state, "verified", "unprefixed hex signature verifies")
  let missing = normalize_inbound({binding_id: "primary", body_text: BODY, headers: HEADERS})
  assert_eq(missing.type, "reject", "missing signature header rejects when secret is configured")
  assert_eq(missing.reject.status, 401, "missing signature is unauthorized")
  let wrong_key = normalize_inbound(
    {
      binding_id: "primary",
      body_text: BODY,
      headers: HEADERS + {"x-gitea-signature": "sha256=" + hmac_sha256("not-it", BODY)},
    },
  )
  assert_eq(wrong_key.type, "reject", "mismatched signature rejects")
  assert_eq(wrong_key.reject.status, 401, "mismatched signature is unauthorized")
  shutdown()
}
