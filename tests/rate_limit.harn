import { call, init, shutdown } from "../src/lib"

@complexity(allow)
pipeline default() {
  shutdown()
  init()
  http_mock_clear()
  http_mock(
    "GET",
    "https://gitea.example.com/api/v1/projects",
    {
      responses: [
        {
          status: 429,
          body: "{\"message\":\"rate limited\"}",
          headers: {"x-ratelimit-remaining": "0", "x-ratelimit-reset": "0"},
        },
        {
          status: 200,
          body: "{\"ok\":true}",
          headers: {"x-ratelimit-remaining": "59", "x-ratelimit-reset": "0"},
        },
      ],
    },
  )
  let retry_response = call("api.request", {path: "/projects", access_token: "tok"})
  assert_eq(retry_response.ok, true, "rate-limit retry succeeds on second attempt")
  http_mock_clear()
  http_mock(
    "GET",
    "https://gitea.example.com/api/v1/projects",
    {
      status: 429,
      body: "{\"message\":\"rate limited\"}",
      headers: {"x-ratelimit-remaining": "0", "x-ratelimit-reset": "9999999999"},
    },
  )
  let too_far = call("api.request", {path: "/projects", access_token: "tok"})
  assert(is_err(too_far), "reset more than 60s away is rejected")
  assert_eq(unwrap_err(too_far).code, "rate_limited", "rate_limited error code")
  http_mock_clear()
  let acquired = call(
    "rate_limit.acquire",
    {capacity: 2, refill_tokens: 1, refill_interval_ms: 1000, scope: "outbound", now_ms: 0},
  )
  assert_eq(acquired.allowed, true, "first acquire allowed")
  let second = call(
    "rate_limit.acquire",
    {capacity: 2, refill_tokens: 1, refill_interval_ms: 1000, scope: "outbound", now_ms: 0},
  )
  assert_eq(second.allowed, true, "second acquire allowed")
  let denied = call(
    "rate_limit.acquire",
    {capacity: 2, refill_tokens: 1, refill_interval_ms: 1000, scope: "outbound", now_ms: 0},
  )
  assert_eq(denied.allowed, false, "third acquire denied at capacity")
  assert(denied.retry_after_ms > 0, "denied returns retry_after_ms")
  let refilled = call(
    "rate_limit.acquire",
    {capacity: 2, refill_tokens: 1, refill_interval_ms: 1000, scope: "outbound", now_ms: 1000},
  )
  assert_eq(refilled.allowed, true, "refill restores a token after the interval")
  let other_scope = call(
    "rate_limit.acquire",
    {capacity: 1, refill_tokens: 1, refill_interval_ms: 1000, scope: "other", now_ms: 0},
  )
  assert_eq(other_scope.allowed, true, "scopes track buckets independently")
  shutdown()
}
