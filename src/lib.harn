import {
  paginate_cursor,
  rate_limit_token_bucket,
  verify_hmac_signature,
} from "std/connectors/shared"

let PROVIDER_ID = "gitea"

let STATE_KEY = "harn-gitea-connector.state"

let RATE_LIMIT_STATE_KEY = "harn-gitea-connector.rate_limit"

let DEFAULT_API_BASE_URL = "https://gitea.example.com/api/v1"

let ENV_PREFIX = "GITEA"

let SIGNATURE_HEADER = "x-gitea-signature"

let EVENT_HEADER = "x-gitea-event"

let SUPPORTED_EVENTS = ["push", "pull_request", "issues", "issue_comment", "release", "repository", "star"]

let DELIVERY_HEADERS = ["x-gitea-delivery"]

let DEFAULT_PAGE_LIMIT = 50

let MAX_RATE_LIMIT_WAIT_SECONDS = 60

let DEFAULT_RATE_LIMIT_CAPACITY = 60

let DEFAULT_RATE_LIMIT_REFILL_TOKENS = 1

let DEFAULT_RATE_LIMIT_REFILL_INTERVAL_MS = 1000

let OUTBOUND_METHODS = [
  "api.request",
  "pull_requests.comment",
  "pull_requests.update",
  "pull_requests.list",
  "pull_requests.list_all",
  "issues.comment",
  "issues.list",
  "issues.list_all",
  "repositories.list",
  "commit_status.set",
  "repository_file.get",
  "rate_limit.acquire",
]

/** Return this connector's provider id. */
pub fn provider_id() {
  return PROVIDER_ID
}

/** Return supported trigger kinds. */
pub fn kinds() {
  return ["webhook"]
}

/** Return the normalized payload schema metadata. */
pub fn payload_schema() {
  return {
    harn_schema_name: "GiteaEventPayload",
    json_schema: {
      type: "object",
      required: ["event", "repository", "actor", "raw"],
      additionalProperties: true,
      properties: {
        event: {type: "string"},
        action: {type: ["string", "null"]},
        repository: {type: ["object", "null"], additionalProperties: true},
        actor: {type: ["object", "null"], additionalProperties: true},
        resource: {type: ["object", "null"], additionalProperties: true},
        raw: {type: "object"},
      },
    },
  }
}

/** Initialize connector state with orchestrator context. */
pub fn init(ctx = nil) {
  let next = __state() + {initialized: true, ctx: ctx ?? {}}
  __set_state(next)
  return next
}

/** Activate configured trigger bindings. */
pub fn activate(bindings = []) {
  var by_id = {}
  var seen_paths = {}
  for binding in bindings ?? [] {
    let binding_id = binding?.binding_id ?? binding?.id ?? "binding-" + to_string(len(by_id.keys()))
    let path = binding?.path ?? binding?.match?.path
    if path != nil && path != "" {
      if seen_paths.get(path) {
        return __err(
          "activation",
          PROVIDER_ID + " connector path `" + path + "` is configured by multiple bindings",
        )
      }
      seen_paths[path] = true
    }
    by_id[binding_id] = binding + {binding_id: binding_id}
  }
  let next = __state() + {bindings: by_id, active: true}
  __set_state(next)
  return {provider: PROVIDER_ID, bindings: len(by_id.keys())}
}

/**
 * Clear connector lifecycle state.
 *
 * @host_only — this entry point wipes cached binding state including secrets resolved during
 * activate(). It must only be invoked by the orchestrator's connector lifecycle, never from
 * untrusted pipeline nodes or external callers. Full caller-identity gating is tracked as a
 * host responsibility.
 */
pub fn shutdown() {
  store_delete(STATE_KEY)
  store_delete(RATE_LIMIT_STATE_KEY)
  return {provider: PROVIDER_ID, active: false}
}

@complexity(allow)
/** Verify and normalize an inbound webhook request. */
pub fn normalize_inbound(raw) {
  let headers = raw?.headers ?? {}
  // Resolve the signed surface (raw bytes preferred over body_text) before parsing JSON so an
  // unsigned/oversized payload cannot exhaust the parser ahead of signature verification.
  let signed = __signed_surface(raw)
  if is_err(signed) {
    return __reject_err(unwrap_err(signed))
  }
  let body_text = unwrap(signed)
  let verified = __verify_signature(raw, headers, body_text)
  if is_err(verified) {
    return __reject_err(unwrap_err(verified))
  }
  let signature_status = unwrap(verified)
  let parsed = try {
    json_parse(body_text)
  }
  if is_err(parsed) {
    return __reject(400, "invalid_json", PROVIDER_ID + " payload body is not valid JSON")
  }
  let payload = unwrap(parsed)
  let base_event = __base_event(payload, headers)
  if base_event == nil || base_event == "" {
    return __reject(400, "missing_event", "missing " + PROVIDER_ID + " event header or payload event")
  }
  if !__supports_event(base_event) {
    return __reject(
      400,
      "unsupported_event",
      "unsupported " + PROVIDER_ID + " event `" + to_string(base_event) + "`",
    )
  }
  let event = __build_event(base_event, payload, raw, headers, signature_status, body_text)
  return {type: "event", event: event}
}

/** Run one polling tick for providers that support polling. */
pub fn poll_tick(ctx = nil) {
  return {type: "batch", events: [], cursor: ctx?.cursor, state: ctx?.state ?? {}}
}

@complexity(allow)
/** Dispatch a supported outbound helper method. */
pub fn call(method, args = {}) {
  if !contains(OUTBOUND_METHODS, method) {
    return __err(
      "method_not_found",
      PROVIDER_ID + " connector does not implement outbound method `" + method + "`",
    )
  }
  if method == "api.request" {
    return __api_request(args ?? {})
  }
  if method == "rate_limit.acquire" {
    return __rate_limit_acquire(args ?? {})
  }
  if method == "pull_requests.comment" {
    return __api_request(
      args
        + {
        method: "POST",
        path: args?.path ?? __pull_request_comment_path(args),
        body: {body: args?.body ?? args?.comment},
      },
    )
  }
  if method == "pull_requests.update" {
    return __api_request(
      args
        + {
        method: "PATCH",
        path: args?.path ?? __pull_request_path(args),
        body: __body_without(args, __config_keys() + ["owner", "repo", "pull_request", "pull_request_id", "path"]),
      },
    )
  }
  if method == "pull_requests.list" {
    return __api_request(
      args + {method: "GET", path: __list_path("/repos/" + __repo_ref(args) + "/pulls", args)},
    )
  }
  if method == "pull_requests.list_all" {
    return __paginate_all("/repos/" + __repo_ref(args) + "/pulls", args)
  }
  if method == "issues.comment" {
    return __api_request(
      args
        + {
        method: "POST",
        path: args?.path ?? __issue_comment_path(args),
        body: {body: args?.body ?? args?.comment},
      },
    )
  }
  if method == "issues.list" {
    return __api_request(
      args + {method: "GET", path: __list_path("/repos/" + __repo_ref(args) + "/issues", args)},
    )
  }
  if method == "issues.list_all" {
    return __paginate_all("/repos/" + __repo_ref(args) + "/issues", args)
  }
  if method == "repositories.list" {
    return __api_request(args + {method: "GET", path: __list_path("/repos/search", args)})
  }
  if method == "commit_status.set" {
    return __api_request(
      args
        + {
        method: "POST",
        path: args?.path ?? __commit_status_path(args),
        body: __body_without(args, __config_keys() + ["owner", "repo", "sha", "path"]),
      },
    )
  }
  return __api_request(args + {method: "GET", path: args?.path ?? __repository_file_path(args)})
}

fn __state() {
  return store_get(STATE_KEY) ?? {initialized: false, active: false, bindings: {}, ctx: {}}
}

fn __set_state(state) {
  store_set(STATE_KEY, state)
  return state
}

fn __err(code, message) {
  return Err({code: code, message: message})
}

fn __reject(status, code, message) {
  return {
    type: "reject",
    reject: {
      status: status,
      body: json_stringify({error: code, message: message}),
      content_type: "application/json",
    },
  }
}

fn __reject_err(err) {
  let code = err?.code ?? "rejected"
  let status = if code == "invalid_signature" || code == "missing_signature" {
    401
  } else if code == "missing_binding_id" || code == "missing_body" || code == "invalid_body" {
    400
  } else {
    400
  }
  return __reject(status, code, err?.message ?? "request rejected")
}

fn __header(headers, name) {
  let wanted = lowercase(name)
  for entry in (headers ?? {}).entries() {
    if lowercase(trim(to_string(entry.key))) == wanted {
      return trim(to_string(entry.value))
    }
  }
  return nil
}

fn __base_event(payload, headers) {
  let from_header = __header(headers, EVENT_HEADER)
  if from_header != nil && from_header != "" {
    return to_string(from_header)
  }
  return payload?.event ?? payload?.event_name ?? payload?.object_kind ?? payload?.type ?? payload?.action
}

fn __supports_event(event) {
  if contains(SUPPORTED_EVENTS, event) {
    return true
  }
  let normalized = __normalize_kind(event)
  // Match either an exact normalized name (e.g. "push") or a fully-qualified subkind
  // ("push.created"). A bare prefix is rejected so "pushy" never spoofs "push".
  for supported in SUPPORTED_EVENTS {
    let supported_norm = __normalize_kind(supported)
    if normalized == supported_norm || starts_with(normalized, supported_norm + ".") {
      return true
    }
  }
  return false
}

fn __verify_signature(raw, headers, body_text) {
  let binding_id = raw?.metadata?.binding_id ?? raw?.binding_id
  if binding_id == nil || trim(to_string(binding_id)) == "" {
    return __err("missing_binding_id", "request did not include a binding_id; cannot resolve secret")
  }
  let secret = __signing_secret(raw)
  // Fail-closed: refuse delivery when no signing secret is configured for this binding. Hosts
  // must configure a secret in connector ctx, the per-binding state, or env before bindings
  // accept webhooks.
  if secret == nil || trim(to_string(secret)) == "" {
    return __err("missing_signature", "no signing secret configured for this binding")
  }
  let provided = __header(headers, SIGNATURE_HEADER)
  if provided == nil || provided == "" {
    return __err("missing_signature", SIGNATURE_HEADER + " header missing but a signing_secret is configured")
  }
  if verify_hmac_signature(body_text, to_string(provided), to_string(secret)) {
    return Ok("signed")
  }
  return __err("invalid_signature", SIGNATURE_HEADER + " did not match the configured signing_secret")
}

/**
 * Resolve the byte surface that was signed. Prefer raw.body_text when present; otherwise
 * base64-decode raw.body_base64 so HMAC runs over the actual transport bytes. Reject the
 * request outright when neither field is present so we never HMAC over "" by accident.
 */
fn __signed_surface(raw) {
  let body_text = raw?.body_text ?? raw?.body
  if body_text != nil {
    return Ok(to_string(body_text))
  }
  let body_b64 = raw?.body_base64
  if body_b64 != nil && trim(to_string(body_b64)) != "" {
    let decoded = try {
      base64_decode(to_string(body_b64))
    }
    if is_err(decoded) {
      return __err("invalid_body", "body_base64 is not valid base64")
    }
    return Ok(unwrap(decoded))
  }
  return __err("missing_body", "request has neither body_text nor body_base64")
}

/**
 * Resolve the signing secret from trusted sources only: orchestrator ctx, the per-binding
 * state seeded via activate(), or the process env. raw.* fields are attacker-controlled and
 * must not feed the HMAC key. binding_id is required; we refuse the single-binding fallback
 * so that secrets are never resolved without an explicit binding pointer.
 */
fn __signing_secret(raw) {
  let state = __state()
  let ctx_secret = state?.ctx?.signing_secret ?? state?.ctx?.secrets?.signing_secret
  if ctx_secret != nil && trim(to_string(ctx_secret)) != "" {
    return to_string(ctx_secret)
  }
  let binding_id = raw?.metadata?.binding_id ?? raw?.binding_id
  if binding_id == nil || trim(to_string(binding_id)) == "" {
    return nil
  }
  let bindings = state?.bindings ?? {}
  let binding = bindings.get(binding_id)
  let bound = binding?.signing_secret ?? binding?.secrets?.signing_secret ?? binding?.config?.signing_secret
  if bound != nil && trim(to_string(bound)) != "" {
    return to_string(bound)
  }
  let env_secret = env(ENV_PREFIX + "_SIGNING_SECRET")
  if env_secret != nil && trim(to_string(env_secret)) != "" {
    return to_string(env_secret)
  }
  return nil
}

@complexity(allow)
fn __build_event(base_event, payload, raw, headers, signature_status, body_text) {
  let kind = __event_kind(base_event, payload)
  return {
    kind: kind,
    occurred_at: raw?.occurred_at ?? payload?.updated_at ?? payload?.created_at ?? payload?.timestamp,
    dedupe_key: __dedupe_key(base_event, payload, raw, headers, body_text),
    signature_status: __signature_status(signature_status),
    payload: {
      event: base_event,
      action: payload?.action,
      repository: __repository(payload),
      actor: __actor(payload),
      resource: __resource(payload),
      raw: payload,
    },
    headers: __normalized_headers(headers),
  }
}

fn __signature_status(status) {
  if status == "signed" || status == "verified" {
    return {state: "verified"}
  }
  return {state: "unsigned"}
}

fn __event_kind(base_event, payload) {
  let normalized = __normalize_kind(base_event)
  let action = payload?.action ?? payload?.pullrequest?.state ?? payload?.object_attributes?.action
  if action == nil || action == "" || contains(normalized, ".") {
    return normalized
  }
  return normalized + "." + __normalize_kind(action)
}

fn __normalize_kind(value) {
  return lowercase(replace(replace(to_string(value), ":", "."), " ", "_"))
}

fn __repository(payload) {
  let repo = payload?.repository ?? payload?.repo ?? {}
  return {
    id: repo?.id ?? repo?.uuid,
    name: repo?.name,
    full_name: repo?.full_name ?? repo?.path_with_namespace ?? repo?.canonical_name,
    url: repo?.html_url ?? repo?.web_url ?? repo?.links?.html?.href ?? repo?.url,
  }
}

fn __actor(payload) {
  let actor = payload?.sender ?? payload?.user ?? payload?.actor ?? payload?.pusher ?? {}
  return {
    id: actor?.id ?? actor?.uuid,
    username: actor?.login ?? actor?.username ?? actor?.nickname ?? actor?.canonical_name,
    name: actor?.name ?? actor?.display_name,
    email: actor?.email,
  }
}

fn __resource(payload) {
  return payload?.pull_request ?? payload?.pullrequest ?? payload?.issue ?? payload?.comment
    ?? payload?.release
    ?? payload?.object_attributes
    ?? {revision: payload?.revision, changed_paths: payload?.changed_paths, commits: payload?.commits}
}

fn __dedupe_key(base_event, payload, raw, headers, body_text) {
  // Trust only the host-set delivery header — payload?.id / .uuid / .delivery_id are
  // attacker-controlled and would let a sender either suppress replay protection (pin id
  // constant) or evade it (vary id) at will. When no delivery header is present, derive the
  // key from immutable host-side fields.
  for header in DELIVERY_HEADERS {
    let value = __header(headers, header)
    if value != nil && value != "" {
      return PROVIDER_ID + ":" + __normalize_kind(base_event) + ":" + to_string(value)
    }
  }
  let binding_id = raw?.metadata?.binding_id ?? raw?.binding_id ?? ""
  let received_at = raw?.received_at ?? raw?.occurred_at ?? ""
  let body_b64 = raw?.body_base64 ?? body_text
  return PROVIDER_ID + ":" + __normalize_kind(base_event) + ":"
    + sha256(to_string(body_b64) + "|" + to_string(received_at) + "|" + to_string(binding_id))
}

fn __normalized_headers(headers) {
  var normalized = {}
  let event = __header(headers, EVENT_HEADER)
  if event != nil {
    normalized[EVENT_HEADER] = event
  }
  let signature = __header(headers, SIGNATURE_HEADER)
  if signature != nil {
    normalized[SIGNATURE_HEADER] = signature
  }
  for header in DELIVERY_HEADERS {
    let value = __header(headers, header)
    if value != nil {
      normalized[header] = value
    }
  }
  return normalized
}

@complexity(allow)
fn __outbound_config(args) {
  let env_base = ENV_PREFIX + "_API_BASE_URL"
  let env_token = ENV_PREFIX + "_TOKEN"
  let api_base_url = args?.api_base_url ?? env_or(env_base, DEFAULT_API_BASE_URL)
  let access_token = args?.access_token ?? args?.token ?? args?.personal_access_token ?? args?.app_password
    ?? args?.secrets?.access_token
    ?? env(env_token)
  return Ok({api_base_url: to_string(api_base_url), access_token: access_token})
}

fn __config_keys() {
  return ["api_base_url", "access_token", "token", "personal_access_token", "app_password", "secrets"]
}

fn __body_without(args, keys) {
  let body = args ?? {} + {}
  for key in keys {
    body.remove(key)
  }
  return body
}

@complexity(allow)
fn __api_request(args) {
  let config = __outbound_config(args ?? {})
  if is_err(config) {
    return config
  }
  let cfg = unwrap(config)
  let method = uppercase(to_string(args?.method ?? "GET"))
  let path = args?.path ?? args?.url_path ?? ""
  let url_result = __api_url(cfg.api_base_url, path)
  if is_err(url_result) {
    return url_result
  }
  let url = unwrap(url_result)
  var options = {headers: {Accept: "application/json"}, retry: {max: 0, backoff_ms: 0}}
  if cfg.access_token != nil && trim(to_string(cfg.access_token)) != "" {
    options.headers["Authorization"] = "Bearer " + to_string(cfg.access_token)
  }
  if args?.body != nil {
    options["body"] = json_stringify(args.body)
    options.headers["Content-Type"] = "application/json"
  }
  var retried_rate_limit = false
  while true {
    let response_result = try {
      http_request(method, url, options)
    }
    if is_err(response_result) {
      return __err("transport", to_string(unwrap_err(response_result)))
    }
    let response = unwrap(response_result)
    let limited = __maybe_wait_for_rate_limit(response)
    if is_err(limited) {
      return limited
    }
    if (response.status == 429 || response.status == 503) && unwrap(limited) && !retried_rate_limit {
      retried_rate_limit = true
      continue
    }
    if response.status < 200 || response.status >= 300 {
      let code = if response.status == 429 || response.status == 503 {
        "rate_limited"
      } else if response.status == 401 || response.status == 403 {
        "unauthorized"
      } else {
        "transport"
      }
      return __err(
        code,
        PROVIDER_ID + " API request failed with status " + to_string(response.status) + ": "
          + to_string(response.body ?? ""),
      )
    }
    if trim(response.body ?? "") == "" {
      return {status: response.status, headers: response.headers, body: ""}
    }
    let parsed = try {
      json_parse(response.body)
    }
    if is_err(parsed) {
      return __err("invalid_response", PROVIDER_ID + " API returned invalid JSON")
    }
    return unwrap(parsed)
  }
}

/**
 * SSRF defence: refuse absolute-URL paths so the configured api_base_url (and any attached
 * Authorization header) cannot be redirected to attacker-chosen hosts. Callers must pass a
 * relative path; absolute URLs return Err.
 */
fn __api_url(api_base_url, path) {
  let base = trim(to_string(api_base_url))
  let path_str = to_string(path ?? "")
  if starts_with(path_str, "http://") || starts_with(path_str, "https://") {
    return __err(
      "invalid_path",
      PROVIDER_ID + " api request path must be relative; absolute URLs are rejected",
    )
  }
  let prefix = if ends_with(base, "/") {
    base[0:len(base) - 1]
  } else {
    base
  }
  let suffix = if starts_with(path_str, "/") {
    path_str
  } else {
    "/" + path_str
  }
  return Ok(prefix + suffix)
}

fn __repo_ref(args) {
  let owner = args?.owner ?? args?.workspace ?? args?.project ?? ""
  let repo = args?.repo ?? args?.repository ?? ""
  if owner != "" && repo != "" {
    return url_encode(to_string(owner)) + "/" + url_encode(to_string(repo))
  }
  return url_encode(to_string(args?.repo_full_name ?? args?.repository_full_name ?? ""))
}

fn __pull_request_path(args) {
  return "/repos/" + __repo_ref(args) + "/pulls/" + to_string(args?.pull_request ?? args?.pull_request_id)
}

fn __pull_request_comment_path(args) {
  return __pull_request_path(args) + "/comments"
}

fn __issue_comment_path(args) {
  return "/repos/" + __repo_ref(args) + "/issues/" + to_string(args?.issue ?? args?.issue_id) + "/comments"
}

fn __commit_status_path(args) {
  return "/repos/" + __repo_ref(args) + "/statuses/" + to_string(args?.sha ?? args?.commit)
}

fn __repository_file_path(args) {
  return "/repos/" + __repo_ref(args) + "/contents/" + url_encode(to_string(args?.path ?? ""))
}

let LIST_FILTER_KEYS = ["state", "type", "sort", "direction", "labels", "milestones", "q", "since", "before"]

fn __filter_query_parts(args) {
  var parts = []
  for key in LIST_FILTER_KEYS {
    let value = args.get(key)
    if value != nil && trim(to_string(value)) != "" {
      parts = parts + [key + "=" + url_encode(to_string(value))]
    }
  }
  return parts
}

fn __list_path(base_path, args) {
  var parts = __filter_query_parts(args)
  let limit = args?.limit ?? args?.per_page
  if limit != nil {
    parts = parts + ["limit=" + url_encode(to_string(limit))]
  }
  if args?.page != nil {
    parts = parts + ["page=" + url_encode(to_string(args.page))]
  }
  if len(parts) == 0 {
    return base_path
  }
  return base_path + "?" + join(parts, "&")
}

@complexity(allow)
fn __paginate_all(base_path, args) {
  let config = __outbound_config(args ?? {})
  if is_err(config) {
    return config
  }
  let cfg = unwrap(config)
  let limit = args?.limit ?? args?.per_page ?? DEFAULT_PAGE_LIMIT
  let max_pages = args?.max_pages ?? 100
  let initial_url_result = __api_url(cfg.api_base_url, base_path)
  if is_err(initial_url_result) {
    return initial_url_result
  }
  let initial_url = unwrap(initial_url_result)
  let result = paginate_cursor(
    initial_url,
    { url, cursor -> __fetch_paginated_page(url, cursor, limit, args, base_path) },
    "/next_cursor",
    {items_path: "/items", initial_cursor: 1, max_pages: max_pages},
  )
  for page in result.pages {
    if is_err(page) {
      return page
    }
  }
  return {items: result.items, complete: result.complete, pages_fetched: len(result.pages)}
}

@complexity(allow)
fn __fetch_paginated_page(url, cursor, limit, args, base_path) {
  let page_num = cursor ?? 1
  var parts = ["page=" + to_string(page_num), "limit=" + to_string(limit)] + __filter_query_parts(args)
  let path = base_path + "?" + join(parts, "&")
  let response = __api_request(args + {method: "GET", path: path})
  if is_err(response) {
    return response
  }
  let items = if type_of(response) == "list" {
    response
  } else {
    response?.data ?? []
  }
  let next_cursor = if len(items) < limit {
    nil
  } else {
    page_num + 1
  }
  return {items: items, next_cursor: next_cursor}
}

fn __maybe_wait_for_rate_limit(response) {
  let remaining = __header(response.headers ?? {}, "x-ratelimit-remaining")
  if remaining == nil || trim(to_string(remaining)) != "0" {
    return Ok(false)
  }
  let reset = __header(response.headers ?? {}, "x-ratelimit-reset")
  if reset == nil || trim(to_string(reset)) == "" {
    return Ok(true)
  }
  let parsed_reset = try {
    to_int(reset)
  }
  if is_err(parsed_reset) {
    return Ok(true)
  }
  let wait_seconds = unwrap(parsed_reset) - to_int(timestamp())
  if wait_seconds > MAX_RATE_LIMIT_WAIT_SECONDS {
    return __err(
      "rate_limited",
      PROVIDER_ID + " API rate limit reset is more than " + to_string(MAX_RATE_LIMIT_WAIT_SECONDS)
        + " seconds away",
    )
  }
  if wait_seconds > 0 {
    sleep(wait_seconds * 1000)
  }
  return Ok(true)
}

fn __rate_limit_acquire(args) {
  let scope = to_string(args?.scope ?? "default")
  let bucket_state = store_get(RATE_LIMIT_STATE_KEY) ?? {}
  let config = {
    capacity: args?.capacity ?? DEFAULT_RATE_LIMIT_CAPACITY,
    refill_tokens: args?.refill_tokens ?? DEFAULT_RATE_LIMIT_REFILL_TOKENS,
    refill_interval_ms: args?.refill_interval_ms ?? DEFAULT_RATE_LIMIT_REFILL_INTERVAL_MS,
  }
  let decision = rate_limit_token_bucket(bucket_state.get(scope), config, args?.now_ms)
  store_set(RATE_LIMIT_STATE_KEY, bucket_state + {[scope]: decision.state})
  return {allowed: decision.allowed, retry_after_ms: decision.retry_after_ms, scope: scope}
}
