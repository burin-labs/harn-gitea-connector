import { paginate_cursor, rate_limit_token_bucket } from "std/connectors/shared"
import { create_git_forge } from "./git_forge"

const PROVIDER_ID = "gitea"

const STATE_KEY = "harn-gitea-connector.state"

const RATE_LIMIT_STATE_KEY = "harn-gitea-connector.rate_limit"

const DEFAULT_API_BASE_URL = "https://gitea.example.com/api/v1"

const DELIVERY_HEADERS = ["x-gitea-delivery"]

const DEFAULT_PAGE_LIMIT = 50

const MAX_RATE_LIMIT_WAIT_SECONDS = 60

const DEFAULT_RATE_LIMIT_CAPACITY = 60

const DEFAULT_RATE_LIMIT_REFILL_TOKENS = 1

const DEFAULT_RATE_LIMIT_REFILL_INTERVAL_MS = 1000

const OUTBOUND_METHODS = [
  "api.request",
  "pull_requests.comment",
  "pull_requests.update",
  "pull_requests.list",
  "pull_requests.list_all",
  "issues.comment",
  "issues.list",
  "issues.list_all",
  "repositories.list",
  "commit_status.set",
  "repository_file.get",
  "rate_limit.acquire",
]

const engine = create_git_forge(
  {
    provider_id: PROVIDER_ID,
    state_key: STATE_KEY,
    rate_limit_state_key: RATE_LIMIT_STATE_KEY,
    api_base_url: DEFAULT_API_BASE_URL,
    delivery_headers: DELIVERY_HEADERS,
    schema_name: "GiteaEventPayload",
    revision_resource_fallback: true,
  },
)

pub fn provider_id() {
  return engine.provider_id()
}

pub fn kinds() {
  return engine.kinds()
}

pub fn payload_schema() {
  return engine.payload_schema()
}

pub fn init(harness: Harness, ctx: any = nil) {
  return engine.init(harness, ctx)
}

pub fn activate(harness: Harness, bindings: any = []) {
  return engine.activate(harness, bindings)
}

pub fn shutdown(harness: Harness) {
  return engine.shutdown(harness)
}

pub fn normalize_inbound(harness: Harness, raw: any) {
  return engine.normalize_inbound(harness, raw)
}

/** Run one polling tick for providers that support polling. */
pub fn poll_tick(harness: Harness, ctx: any = nil) {
  return {type: "batch", events: [], cursor: ctx?.cursor, state: ctx?.state ?? {}}
}

@complexity(allow)
/** Dispatch a supported outbound helper method. */
pub fn call(harness: Harness, method: any, args: any = {}) {
  if !contains(OUTBOUND_METHODS, method) {
    return engine.__err(
      "method_not_found",
      PROVIDER_ID + " connector does not implement outbound method `" + method + "`",
    )
  }
  if method == "api.request" {
    return __api_request(harness, args ?? {})
  }
  if method == "rate_limit.acquire" {
    return __rate_limit_acquire({clock: harness.clock, runtime: harness.runtime}, args ?? {})
  }
  if method == "pull_requests.comment" {
    return __comment_post(harness, args, engine.__pull_request_comment_path(args))
  }
  if method == "pull_requests.update" {
    return __api_request(
      harness,
      args
        + {
          method: "PATCH",
          path: args?.path ?? engine.__pull_request_path(args),
          body: __body_without(
            args,
            __config_keys() + ["owner", "repo", "pull_request", "pull_request_id", "path"],
          ),
        },
    )
  }
  if method == "pull_requests.list" {
    return __api_request(
      harness,
      args
        + {method: "GET", path: __list_path("/repos/" + engine.__repo_ref(args) + "/pulls", args)},
    )
  }
  if method == "pull_requests.list_all" {
    return __paginate_all(harness, "/repos/" + engine.__repo_ref(args) + "/pulls", args)
  }
  if method == "issues.comment" {
    return __comment_post(harness, args, engine.__issue_comment_path(args))
  }
  if method == "issues.list" {
    return __api_request(
      harness,
      args
        + {method: "GET", path: __list_path("/repos/" + engine.__repo_ref(args) + "/issues", args)},
    )
  }
  if method == "issues.list_all" {
    return __paginate_all(harness, "/repos/" + engine.__repo_ref(args) + "/issues", args)
  }
  if method == "repositories.list" {
    return __api_request(harness, args + {method: "GET", path: __list_path("/repos/search", args)})
  }
  if method == "commit_status.set" {
    return __api_request(
      harness,
      args
        + {
          method: "POST",
          path: args?.path ?? engine.__commit_status_path(args),
          body: __body_without(args, __config_keys() + ["owner", "repo", "sha", "path"]),
        },
    )
  }
  return __api_request(
    harness,
    args + {method: "GET", path: args?.path ?? engine.__repository_file_path(args)},
  )
}

fn __config_keys() {
  return [
    "api_base_url",
    "access_token",
    "token",
    "personal_access_token",
    "app_password",
    "secrets",
  ]
}

fn __body_without(args: any, keys: any) {
  const body = (args ?? {}) + {}
  for key in keys {
    body.remove(key)
  }
  return body
}

@complexity(allow)
fn __api_request(harness: Harness, args: any) {
  const config = engine.__outbound_config(harness.env, args ?? {})
  if is_err(config) {
    return config
  }
  const cfg = unwrap(config)
  const method = uppercase(to_string(args?.method ?? "GET"))
  const path = args?.path ?? args?.url_path ?? ""
  const url_result = engine.__api_url(cfg.api_base_url, path)
  if is_err(url_result) {
    return url_result
  }
  const url = unwrap(url_result)
  let options = {headers: {Accept: "application/json"}, retry: {max: 0, backoff_ms: 0}}
  if cfg.access_token != nil && trim(to_string(cfg.access_token)) != "" {
    options.headers["Authorization"] = "Bearer " + to_string(cfg.access_token)
  }
  if args?.body != nil {
    options["body"] = json_stringify(args.body)
    options.headers["Content-Type"] = "application/json"
  }
  let retried_rate_limit = false
  while true {
    const response_result = try {
      harness.net.request(method, url, options)
    }
    if is_err(response_result) {
      return engine.__err("transport", to_string(unwrap_err(response_result)))
    }
    const response = unwrap(response_result)
    const limited = __maybe_wait_for_rate_limit(harness.clock, response)
    if is_err(limited) {
      return limited
    }
    if (response.status == 429 || response.status == 503) && unwrap(limited)
      && !retried_rate_limit {
      retried_rate_limit = true
      continue
    }
    if response.status < 200 || response.status >= 300 {
      const code = if response.status == 429 || response.status == 503 {
        "rate_limited"
      } else if response.status == 401 || response.status == 403 {
        "unauthorized"
      } else {
        "transport"
      }
      return engine.__err(
        code,
        PROVIDER_ID + " API request failed with status " + to_string(response.status) + ": "
          + to_string(response.body ?? ""),
      )
    }
    if trim(response.body ?? "") == "" {
      return {status: response.status, headers: response.headers, body: ""}
    }
    const parsed = try {
      json_parse(response.body)
    }
    if is_err(parsed) {
      return engine.__err("invalid_response", PROVIDER_ID + " API returned invalid JSON")
    }
    return unwrap(parsed)
  }
}

/**
 * POST a `{body}` comment to the given default path. `args.path` overrides the
 * computed path; `args.comment` is accepted as an alias for `args.body`. Shared
 * by `pull_requests.comment` and `issues.comment`, which only differ in path.
 */
fn __comment_post(harness: Harness, args: any, default_path: any) {
  return __api_request(
    harness,
    args
      + {
        method: "POST",
        path: args?.path ?? default_path,
        body: {body: args?.body ?? args?.comment},
      },
  )
}

const LIST_FILTER_KEYS = [
  "state",
  "type",
  "sort",
  "direction",
  "labels",
  "milestones",
  "q",
  "since",
  "before",
]

fn __filter_query_parts(args: any) {
  let parts = []
  for key in LIST_FILTER_KEYS {
    const value = args.get(key)
    if value != nil && trim(to_string(value)) != "" {
      parts = parts + [key + "=" + url_encode(to_string(value))]
    }
  }
  return parts
}

fn __list_path(base_path: any, args: any) {
  let parts = __filter_query_parts(args)
  const limit = args?.limit ?? args?.per_page
  if limit != nil {
    parts = parts + ["limit=" + url_encode(to_string(limit))]
  }
  if args?.page != nil {
    parts = parts + ["page=" + url_encode(to_string(args.page))]
  }
  if len(parts) == 0 {
    return base_path
  }
  return base_path + "?" + join(parts, "&")
}

@complexity(allow)
fn __paginate_all(harness: Harness, base_path: any, args: any) {
  const config = engine.__outbound_config(harness.env, args ?? {})
  if is_err(config) {
    return config
  }
  const cfg = unwrap(config)
  const limit = args?.limit ?? args?.per_page ?? DEFAULT_PAGE_LIMIT
  const max_pages = args?.max_pages ?? 100
  const initial_url_result = engine.__api_url(cfg.api_base_url, base_path)
  if is_err(initial_url_result) {
    return initial_url_result
  }
  const initial_url = unwrap(initial_url_result)
  const result = paginate_cursor(
    initial_url,
    { url, cursor -> __fetch_paginated_page(harness, url, cursor, limit, args, base_path) },
    "/next_cursor",
    {items_path: "/items", initial_cursor: 1, max_pages: max_pages},
  )
  for page in result.pages {
    if is_err(page) {
      return page
    }
  }
  return {items: result.items, complete: result.complete, pages_fetched: len(result.pages)}
}

@complexity(allow)
fn __fetch_paginated_page(
  harness: Harness,
  url: any,
  cursor: any,
  limit: any,
  args: any,
  base_path: any,
) {
  const page_num = cursor ?? 1
  let parts = ["page=" + to_string(page_num), "limit=" + to_string(limit)]
    + __filter_query_parts(args)
  const path = base_path + "?" + join(parts, "&")
  const response = __api_request(harness, args + {method: "GET", path: path})
  if is_err(response) {
    return response
  }
  const items = if type_of(response) == "list" {
    response
  } else {
    response?.data ?? []
  }
  const next_cursor = if len(items) < limit {
    nil
  } else {
    page_num + 1
  }
  return {items: items, next_cursor: next_cursor}
}

fn __maybe_wait_for_rate_limit(clock: HarnessClock, response: any) {
  const remaining = engine.__header(response.headers ?? {}, "x-ratelimit-remaining")
  if remaining == nil || trim(to_string(remaining)) != "0" {
    return Ok(false)
  }
  const reset = engine.__header(response.headers ?? {}, "x-ratelimit-reset")
  if reset == nil || trim(to_string(reset)) == "" {
    return Ok(true)
  }
  const parsed_reset = try {
    to_int(reset)
  }
  if is_err(parsed_reset) {
    return Ok(true)
  }
  const wait_seconds = unwrap(parsed_reset) - to_int(clock.timestamp())
  if wait_seconds > MAX_RATE_LIMIT_WAIT_SECONDS {
    return engine.__err(
      "rate_limited",
      PROVIDER_ID + " API rate limit reset is more than " + to_string(MAX_RATE_LIMIT_WAIT_SECONDS)
        + " seconds away",
    )
  }
  if wait_seconds > 0 {
    clock.sleep_ms(wait_seconds * 1000)
  }
  return Ok(true)
}

fn __rate_limit_acquire(harness: {clock: HarnessClock, runtime: HarnessRuntime}, args: any) {
  const scope = to_string(args?.scope ?? "default")
  const bucket_state = harness.runtime.store_get(RATE_LIMIT_STATE_KEY) ?? {}
  const config = {
    capacity: args?.capacity ?? DEFAULT_RATE_LIMIT_CAPACITY,
    refill_tokens: args?.refill_tokens ?? DEFAULT_RATE_LIMIT_REFILL_TOKENS,
    refill_interval_ms: args?.refill_interval_ms ?? DEFAULT_RATE_LIMIT_REFILL_INTERVAL_MS,
  }
  const decision = rate_limit_token_bucket(
    harness.clock,
    bucket_state.get(scope),
    config,
    args?.now_ms,
  )
  harness.runtime.store_set(RATE_LIMIT_STATE_KEY, bucket_state + {[scope]: decision.state})
  return {allowed: decision.allowed, retry_after_ms: decision.retry_after_ms, scope: scope}
}
